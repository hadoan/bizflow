# Database
DATABASE_URL="postgresql://bizflow:bizflow_dev_password@localhost:5432/bizflow_dev"

# Auth.js / NextAuth
NEXTAUTH_SECRET="your-secret-key-min-32-chars-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider Configuration
AI_PROVIDER="openai"  # Options: openai, anthropic
AI_API_KEY=""         # Your OpenAI or Anthropic API key

# File Storage (S3-compatible)
FILE_STORAGE_BUCKET=""
FILE_STORAGE_ENDPOINT=""
FILE_STORAGE_ACCESS_KEY=""
FILE_STORAGE_SECRET_KEY=""
FILE_STORAGE_REGION="eu-central-1"

# Local file storage path (for development)
LOCAL_STORAGE_PATH="./uploads"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
