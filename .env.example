# ============================================================================
# Bizflow Environment Configuration
# Copy this file to .env.local and update the values
# ============================================================================

# ============================================================================
# Database (PostgreSQL)
# ============================================================================
# Local development
DATABASE_URL="postgresql://bizflow:bizflow_dev_password@localhost:5432/bizflow_dev"

# Docker Compose
# DATABASE_URL="postgresql://bizflow:bizflow_dev_password@postgres:5432/bizflow_dev"

# ============================================================================
# Authentication (NextAuth.js v5)
# ============================================================================
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-min-32-chars-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ============================================================================
# AI Provider Configuration
# ============================================================================
# Options: openai, anthropic
AI_PROVIDER="openai"

# Your API key for the configured provider
# OpenAI: https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/
AI_API_KEY=""

# ============================================================================
# File Storage
# ============================================================================
# LOCAL STORAGE (Development)
LOCAL_STORAGE_PATH="./uploads"

# S3-COMPATIBLE STORAGE (Production)
# AWS S3, MinIO, DigitalOcean Spaces, etc.
FILE_STORAGE_BUCKET=""
FILE_STORAGE_ENDPOINT=""
FILE_STORAGE_ACCESS_KEY=""
FILE_STORAGE_SECRET_KEY=""
FILE_STORAGE_REGION="eu-central-1"

# ============================================================================
# Application Settings
# ============================================================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================================
# Optional: Advanced Configuration
# ============================================================================
# For development/debugging
DEBUG=""
LOG_LEVEL="info"

# ============================================================================
# Observability (Langfuse)
# ============================================================================
# Set to enable prompt/response logging to Langfuse
# Sign up at https://cloud.langfuse.com or self-host
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
# Optional; defaults to https://cloud.langfuse.com
LANGFUSE_HOST="https://cloud.langfuse.com"
